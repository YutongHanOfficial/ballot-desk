n":5},"partial":true},"VT":{"ev":6,"method":"legislature","total":null,"votes":null,"evs":{"jefferson":6}},"VA":{"ev":24,"method":"popular","total":13052,"votes":{"jefferson":12914,"unpledged":129,"other":9},"evs":{"jefferson":24}}},"notes":["This was the first election under the Twelfth Amendment, with each elector casting one vote for president and a separate vote for vice president. George Clinton was elected vice president with 162 electoral votes to 14 for Rufus King.","In the states with a popular vote, the Federalist elector tickets were formally unpledged. Their 39,245 votes appear as “Unpledged electors,” so Charles Cotesworth Pinckney has no popular vote of his own.","The unpledged electors who won Maryland’s 1st and 9th districts voted for Pinckney, as did the Federalist electors chosen by the Connecticut and Delaware legislatures.","The popular vote figures cover only 4 of North Carolina’s 14 districts and 1 of Tennessee’s 5. Some North Carolina district figures include votes rejected from the official count."],"winner":"jefferson"},"congress":{"number":9,"years":"3/4/1805–3/3/1807","house":{"total":142,"seats":[["Democratic-Republicans",114],["Federalists",28]],"vacancies":0},"senate":{"total":34,"seats":[["Democratic-Republicans",27],["Federalists",7]],"vacancies":0}},"sources":[{"title":"Wikipedia, \"1804 United States presidential election\"","url":"https://en.wikipedia.org/wiki/1804_United_States_presidential_election","rev":1384762505},{"title":"House Office of the Historian, \"Party Divisions of the House of Representatives, 1789 to Present\"","url":"https://history.house.gov/Institution/Party-Divisions/Party-Divisions/"},{"title":"Senate Historical Office, \"Party Division\"","url":"https://www.senate.gov/about/parties-leadership/party-division.htm"}]}