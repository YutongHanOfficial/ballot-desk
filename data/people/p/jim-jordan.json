{"slug":"jim-jordan","qid":"Q186215","name":"Jim Jordan","desc":"United States Representative from Ohio since 2007","article":"Jim Jordan","born":"1964-02-17","died":null,"birthplace":"Troy","parties":["Republican Party"],"offices":[{"t":"U.S. Representative","w":"OH-04","f":2007,"u":null},{"t":"State Senate of Ohio","w":"","f":2001,"u":2006}],"summary":"James Daniel Jordan (born February 17, 1964) is an American politician, college wrestler, and former wrestling coach who has served in the U.S. House of Representatives as the representative for Ohio's 4th congressional district since 2007. Previously, he served in the Ohio Senate from 2001 to 2006 and the Ohio House of Representatives from 1995 to 2000. A member of the Republican Party, he will be Republican House Minority Leader in the upcoming 120th Congress.","photo":{"f":"jim-jordan.jpg","by":"US Congress","lic":"Public domain","licUrl":null,"page":"https://commons.wikimedia.org/wiki/File:Jim_Jordan.jpg"},"history":[{"y":2026,"o":"H","k":"OH-04","p":"R","n":"Jim Jordan","race":"OH-04"},{"y":2024,"o":"H","k":"OH-04","p":"R","v":273297,"s":68.46,"w":true,"n":"Jim Jordan"},{"y":2022,"o":"H","k":"OH-04","p":"R","v":200773,"s":69.19,"w":true,"n":"Jim Jordan"},{"y":2020,"o":"H","k":"OH-04","p":"R","v":235875,"s":67.85,"w":true,"n":"Jim Jordan"},{"y":2018,"o":"H","k":"OH-04","p":"R","v":167993,"s":65.26,"w":true,"n":"Jim Jordan"},{"y":2016,"o":"H","k":"OH-04","p":"R","v":210227,"s":67.99,"w":true,"n":"Jim Jordan"},{"y":2014,"o":"H","k":"OH-04","p":"R","v":125907,"s":67.67,"w":true,"n":"Jim Jordan"},{"y":2012,"o":"H","k":"OH-04","p":"R","v":182643,"s":58.35,"w":true,"n":"Jim Jordan"},{"y":2010,"o":"H","k":"OH-04","p":"R","v":146029,"s":71.49,"w":true,"n":"Jim Jordan"},{"y":2008,"o":"H","k":"OH-04","p":"R","v":186154,"s":65.17,"w":true,"n":"Jim Jordan"},{"y":2006,"o":"H","k":"OH-04","p":"R","v":129958,"s":59.99,"w":true,"n":"Jim Jordan"}]}